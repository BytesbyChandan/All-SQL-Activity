WITH dept_ranked_sal AS (
    SELECT
        department,
        salary,
        DENSE_RANK() OVER (
            PARTITION BY department
            ORDER BY salary DESC
        ) AS rnk
    FROM employees
    WHERE salary IS NOT NULL
)
SELECT DISTINCT
    department,
    salary AS second_highest_salary
FROM dept_ranked_sal
WHERE rnk = 2;

select department, avg(salary) as avg_salary
from employees
group by department
order by avg_salary desc
