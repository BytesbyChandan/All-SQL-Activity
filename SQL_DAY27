use windows10db;
Select *, lead(amount,1) over() as forward_am ,lead(amount,2) over() as forward_amount from orders;
Select *, lag(amount,1) over()  as backward_amount from orders;
Select *, 
lead(amount,1) over(partition by customer_name order by order_date) as forward_am  
from orders;

Select *, 
	lag(amount,1,0) over(partition by customer_id order by order_date) as prev2,
	lag(amount,2,0) over(partition by customer_id order by order_date) as prev3,  
	(
    amount + lag(amount,2,0) over(partition by customer_id order by order_date) 
	+ lag(amount,1,0) over(partition by customer_id order by order_date)
    ) as sum
from orders;

Select customer_id, customer_name, amount,
sum(amount) over(rows between unbounded preceding and current row) as Sum
from orders;

Select customer_id, customer_name, amount,
sum(amount) over(rows between 2 preceding and current row) as Sum
from orders;

Select order_id,customer_id, customer_name, amount,
sum(amount) over(partition by customer_id order by order_date
				rows between 2 preceding and current row) as Sum
from orders;

Select order_id,customer_id, customer_name, amount,
sum(amount) over(partition by customer_id order by order_date
				rows between 1 preceding and 1 following) as Sum
from orders;
