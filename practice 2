-- q1
with second_high as (select emp_id, salary, dense_rank() over(order by salary desc) as rnk
from employees)
select * 
from second_high
where rnk=2;

-- q2
select * from employees
where salary >(select avg(salary) from employees);

-- q3
select *
from employees
order by salary desc
limit 3;

-- q4
Select * 
from employees
where emp_name like 'A%t';

-- q5
select * from employees
where department in ('IT', 'HR');

-- q6
select department, count(emp_id) as total_emp
from employees
group by department;

-- q7
select department, avg(salary) as avg_salary
from employees
group by department
having avg_salary>50000;

-- q8
select department, avg(salary) as avg_salary 
from employees
group by department
order by avg_salary desc
limit 1;

-- q9
select emp_name, department
from employees;

-- q10
with high_sal as(select emp_name, department, salary, dense_rank() over(partition by department order by salary desc) as rnk
from employees)
select * from high_sal
where rnk=1;

-- q11
select emp_id, emp_name, salary, row_number() over(order by salary desc) as row_num
from employees;

-- q12
with second_high_dept as(select department, salary, dense_rank() over(partition by department order by salary desc) as rnk
from employees)
select *
from second_high_dept
where rnk=2;

-- q13
select emp_id, emp_name, salary, rank() over(order by salary desc) as rnk
from employees;

-- q14
select salary, lag(salary) over() as prev_sal, salary-lag(salary) over() as diff
from employees;
