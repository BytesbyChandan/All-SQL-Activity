CREATE OR REPLACE TABLE CUSTOMERS_TARGET (
    CUSTOMER_ID NUMBER,
    CUSTOMER_NAME VARCHAR,
    CITY VARCHAR,
    BALANCE NUMBER
);
Insert into customers_target
(
    customer_id,
    customer_name,
    city,
    balance
)
select 
    customer_id,
    customer_name,
    city,
    balance
from customers_stream
where Metadata$action='INSERT';

